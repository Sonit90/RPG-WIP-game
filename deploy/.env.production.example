# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.
APP_ENV=production

# Public names (DNS A/AAAA records pointing at this VPS).
API_DOMAIN=api.example.com
REALM_DOMAIN=realm.example.com

# Database.
POSTGRES_USER=realm
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=realm

# HMAC key for email verification codes (not used for access tokens).
EMAIL_CODE_SECRET=change-me-long-random

# Access-token signing: deploy/secrets/jwt_es256.pem (P-256, PKCS#8). See the deployment doc.
JWT_KEY_ID=realm-1

# SpacetimeDB.
SPACETIMEDB_VERSION=v2.10.2
SPACETIMEDB_DATABASE=realm

# Optional SMTP for verification and password-reset mail.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
