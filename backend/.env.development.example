# Copy to backend/.env for `cargo run` in backend/ (tools/realm-dev.ps1 does this for you).
APP_ENV=development
RUST_LOG=info,generic_auth=debug,realm_game=debug,sqlx=warn
DATABASE_URL=postgres://realm:realm-dev-password@127.0.0.1:5434/realm
# HMAC key for email verification codes (not used for access tokens).
APP__AUTH__JWT_SECRET=dev-only-email-code-secret-change-me
APP__HTTP__BIND=127.0.0.1:8080
APP__HTTP__PUBLIC_URL=http://127.0.0.1:8080
SPACETIMEDB_URL=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=realm
