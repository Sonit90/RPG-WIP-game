# Rust
/target/
**/*.rs.bk
*.pdb

# JetBrains
.idea/
*.iml
*.iws

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Benchmark / capture output
/artifacts/
*.log

# Env / secrets
.env
.env.local

# Packaged distributions (tools/package.ps1)
/dist/

# Art source. Models are megabytes of binary that git cannot pack, so they live beside the
# repository rather than inside it: drop a .glb in assets/ and the loader finds it, and a
# checkout without one falls back to the procedural model. See assets/README.md.
/assets/*
!/assets/README.md
# Levels are source, not art: a scene file is a few kilobytes of JSON that describes what a
# designer built, and losing it loses the level. Everything else under assets/ is binary
# content that lives beside the repository.
!/assets/scenes/
# The character and dungeon catalogs are data the server, client and API compile in.
!/assets/catalog/
# The editor's crash-recovery copies: rewritten every couple of minutes on one machine, and
# meaningless anywhere else. The level itself is the file without `.autosave`.
/assets/scenes/*.autosave.json
# Generated starter content is reproducible - `cargo run --bin asset_gen` writes all of it -
# so it is treated as build output rather than as source.
/assets/generated/

# Local online stack: SpacetimeDB data and logs written by tools/realm-dev.ps1.
/.realm-dev/
